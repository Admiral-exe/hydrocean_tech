# ==========================================
# HYDROCEAN TECH - ENVIRONMENT CONFIGURATION
# ==========================================
# For local testing, mock fallbacks are used automatically.
# When deploying to Vercel, populate these in the Vercel Project Settings > Environment Variables:

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Public Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (Private server-only, for elevated administrative actions)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Business Contact Settings
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210
NEXT_PUBLIC_CONTACT_PHONE=+91 98765 43210
