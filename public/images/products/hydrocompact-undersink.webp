<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 600" width="100%" height="100%">
  <defs>
    <linearGradient id="usBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f8fafc"/>
      <stop offset="100%" stop-color="#cbd5e1"/>
    </linearGradient>
  </defs>
  <rect width="600" height="600" fill="url(#usBg)" rx="24"/>
  <ellipse cx="300" cy="510" rx="190" ry="24" fill="#000000" opacity="0.12"/>
  
  <!-- Under Sink Compact Module -->
  <rect x="150" y="160" width="180" height="320" rx="20" fill="#0f172a" stroke="#334155" stroke-width="3"/>
  <circle cx="240" cy="240" r="30" fill="#0284c7" opacity="0.4"/>
  <text x="240" y="246" fill="#38bdf8" font-family="sans-serif" font-size="14" font-weight="bold" text-anchor="middle">RO COMPACT</text>
  <circle cx="240" cy="380" r="8" fill="#22c55e"/>
  
  <!-- Pressure Tank -->
  <ellipse cx="400" cy="340" rx="70" ry="110" fill="#ffffff" stroke="#94a3b8" stroke-width="2"/>
  <text x="400" y="345" fill="#475569" font-family="sans-serif" font-size="12" font-weight="bold" text-anchor="middle">7L TANK</text>

  <!-- Swan Neck Faucet -->
  <path d="M 440 220 Q 450 140 400 120 Q 360 110 360 150 L 360 160" fill="none" stroke="#64748b" stroke-width="8" stroke-linecap="round"/>
</svg>
