<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 600" width="100%" height="100%">
  <defs>
    <linearGradient id="wallBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f8fafc"/>
      <stop offset="100%" stop-color="#f1f5f9"/>
    </linearGradient>
  </defs>
  <rect width="600" height="600" fill="url(#wallBg)" rx="24"/>
  
  <!-- Modern Kitchen Backdrop -->
  <rect x="50" y="80" width="500" height="200" rx="12" fill="#ffffff" stroke="#e2e8f0" stroke-width="2"/>
  
  <!-- Countertop with plant & purifier -->
  <rect x="0" y="440" width="600" height="160" fill="#334155"/>
  <rect x="0" y="430" width="600" height="10" fill="#475569"/>
  
  <!-- Wall Mount RO Purifier -->
  <rect x="260" y="140" width="190" height="260" rx="18" fill="#ffffff" stroke="#cbd5e1" stroke-width="2"/>
  <rect x="280" y="160" width="150" height="60" rx="8" fill="#0f172a"/>
  <text x="355" y="196" fill="#38bdf8" font-family="sans-serif" font-size="16" font-weight="bold" text-anchor="middle">024 TDS</text>
  <rect x="280" y="235" width="150" height="120" rx="10" fill="#0284c7" opacity="0.8"/>
  
  <!-- Potted Plant on counter -->
  <rect x="90" y="380" width="40" height="50" rx="4" fill="#94a3b8"/>
  <circle cx="100" cy="360" r="25" fill="#22c55e" opacity="0.8"/>
  <circle cx="120" cy="350" r="25" fill="#16a34a" opacity="0.8"/>
  
  <!-- Tap / Sink Area -->
  <path d="M 210 430 L 210 370 Q 210 340 180 340" fill="none" stroke="#94a3b8" stroke-width="6" stroke-linecap="round"/>
</svg>
