<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 600" width="100%" height="100%">
  <defs>
    <linearGradient id="inlineBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fffbeb"/>
      <stop offset="100%" stop-color="#fef3c7"/>
    </linearGradient>
    <linearGradient id="copperCap" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ea580c"/>
      <stop offset="100%" stop-color="#c2410c"/>
    </linearGradient>
  </defs>
  <rect width="600" height="600" fill="url(#inlineBg)" rx="24"/>
  <ellipse cx="300" cy="460" rx="180" ry="20" fill="#000000" opacity="0.12"/>
  
  <!-- In-line Filter Capsule -->
  <g transform="rotate(-30 300 300)">
    <!-- Main White Barrel -->
    <rect x="180" y="240" width="240" height="120" rx="20" fill="#ffffff" stroke="#e2e8f0" stroke-width="2"/>
    <!-- Copper Band -->
    <rect x="230" y="240" width="140" height="120" fill="url(#copperCap)"/>
    <text x="300" y="305" fill="#ffffff" font-family="sans-serif" font-size="12" font-weight="bold" letter-spacing="2" text-anchor="middle">ACTIVE COPPER</text>
    <text x="300" y="325" fill="#fef3c7" font-family="sans-serif" font-size="9" text-anchor="middle">ALKALINE MINERALIZER</text>
    <!-- End Caps with Quick Push Fit -->
    <rect x="150" y="275" width="30" height="50" rx="6" fill="#cbd5e1"/>
    <rect x="420" y="275" width="30" height="50" rx="6" fill="#cbd5e1"/>
    <circle cx="140" cy="300" r="10" fill="#0284c7"/>
    <circle cx="460" cy="300" r="10" fill="#0284c7"/>
  </g>
</svg>
