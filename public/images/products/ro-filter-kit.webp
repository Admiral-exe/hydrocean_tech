<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 600" width="100%" height="100%">
  <defs>
    <linearGradient id="kitBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f0f9ff"/>
      <stop offset="100%" stop-color="#e0f2fe"/>
    </linearGradient>
    <linearGradient id="filterBlue" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#0284c7"/>
      <stop offset="100%" stop-color="#0369a1"/>
    </linearGradient>
  </defs>
  <rect width="600" height="600" fill="url(#kitBg)" rx="24"/>
  <ellipse cx="300" cy="510" rx="200" ry="24" fill="#000000" opacity="0.1"/>
  
  <!-- Filter 1: Sediment -->
  <rect x="140" y="160" width="70" height="310" rx="14" fill="#ffffff" stroke="#cbd5e1" stroke-width="2"/>
  <rect x="140" y="240" width="70" height="120" fill="#0284c7" opacity="0.1"/>
  <text x="175" y="300" fill="#0284c7" font-family="sans-serif" font-size="10" font-weight="bold" text-anchor="middle">SPUN</text>
  <text x="175" y="320" fill="#64748b" font-family="sans-serif" font-size="8" text-anchor="middle">5 MICRON</text>
  
  <!-- Filter 2: Carbon Block -->
  <rect x="235" y="140" width="70" height="330" rx="14" fill="#ffffff" stroke="#cbd5e1" stroke-width="2"/>
  <rect x="235" y="230" width="70" height="130" fill="url(#filterBlue)"/>
  <text x="270" y="295" fill="#ffffff" font-family="sans-serif" font-size="10" font-weight="bold" text-anchor="middle">CARBON</text>
  <text x="270" y="315" fill="#e0f2fe" font-family="sans-serif" font-size="8" text-anchor="middle">BLOCK</text>

  <!-- Filter 3: RO Membrane -->
  <rect x="330" y="150" width="70" height="320" rx="14" fill="#ffffff" stroke="#cbd5e1" stroke-width="2"/>
  <rect x="330" y="240" width="70" height="120" fill="#0284c7" opacity="0.15"/>
  <text x="365" y="300" fill="#0369a1" font-family="sans-serif" font-size="10" font-weight="bold" text-anchor="middle">POST-C</text>
  <text x="365" y="320" fill="#64748b" font-family="sans-serif" font-size="8" text-anchor="middle">POLISHER</text>

  <!-- Filter 4: In-line Spares -->
  <rect x="420" y="170" width="55" height="290" rx="12" fill="#ffffff" stroke="#cbd5e1" stroke-width="2"/>
  <rect x="420" y="250" width="55" height="90" fill="#0284c7" opacity="0.1"/>
  <text x="447" y="295" fill="#0284c7" font-family="sans-serif" font-size="8" font-weight="bold" text-anchor="middle">UF</text>
  
  <text x="300" y="110" fill="#0369a1" font-family="sans-serif" font-size="16" font-weight="bold" letter-spacing="2" text-anchor="middle">OEM GENUINE SPARES SET</text>
</svg>
