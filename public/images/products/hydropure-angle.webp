<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 600" width="100%" height="100%">
  <defs>
    <linearGradient id="kitcBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#eff6ff"/>
      <stop offset="100%" stop-color="#dbeafe"/>
    </linearGradient>
  </defs>
  <rect width="600" height="600" fill="url(#kitcBg)" rx="24"/>
  
  <!-- Countertop -->
  <rect x="0" y="460" width="600" height="140" fill="#cbd5e1"/>
  <rect x="0" y="460" width="600" height="12" fill="#94a3b8"/>
  
  <!-- Wall Tiles Texture -->
  <line x1="0" y1="150" x2="600" y2="150" stroke="#e2e8f0" stroke-width="2"/>
  <line x1="0" y1="300" x2="600" y2="300" stroke="#e2e8f0" stroke-width="2"/>
  
  <!-- Purifier Unit on Wall/Counter -->
  <rect x="180" y="120" width="240" height="340" rx="24" fill="#ffffff" stroke="#cbd5e1" stroke-width="2"/>
  <rect x="210" y="150" width="180" height="80" rx="12" fill="#0f172a"/>
  <text x="250" y="195" fill="#38bdf8" font-family="sans-serif" font-size="22" font-weight="bold">024</text>
  <text x="250" y="210" fill="#94a3b8" font-family="sans-serif" font-size="9">PPM OPTIMAL</text>
  <circle cx="340" cy="190" r="10" fill="#22c55e"/>
  
  <!-- Water Reservoir -->
  <rect x="210" y="250" width="180" height="160" rx="14" fill="#0284c7" opacity="0.85"/>
  <text x="300" y="340" fill="#ffffff" font-family="sans-serif" font-size="16" font-weight="bold" text-anchor="middle">10L PURE TANK</text>
  
  <!-- Glass on Counter -->
  <polygon points="460,400 490,400 482,460 468,460" fill="#38bdf8" opacity="0.5" stroke="#0284c7" stroke-width="2"/>
</svg>
