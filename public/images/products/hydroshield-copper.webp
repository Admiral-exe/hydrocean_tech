  <text x="300" y="300" fill="#b45309" font-family="sans-serif" font-size="18" font-weight="bold" text-anchor="middle">pH 8.5+ Alkaline</text>
  <text x="300" y="325" fill="#78350f" font-family="sans-serif" font-size="12" text-anchor="middle">Copper Mineral Infuser</text>
