<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 600" width="100%" height="100%">
  <defs>
    <linearGradient id="commBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f1f5f9"/>
      <stop offset="100%" stop-color="#e2e8f0"/>
    </linearGradient>
  </defs>
  <rect width="600" height="600" fill="url(#commBg)" rx="24"/>
  <ellipse cx="300" cy="520" rx="210" ry="24" fill="#000000" opacity="0.14"/>
  
  <!-- Stainless Steel Skid Frame -->
  <rect x="140" y="110" width="320" height="390" rx="14" fill="none" stroke="#64748b" stroke-width="8"/>
  <line x1="140" y1="260" x2="460" y2="260" stroke="#64748b" stroke-width="6"/>
  
  <!-- Dual Big Blue Housing Filters -->
  <rect x="180" y="140" width="60" height="280" rx="12" fill="#0284c7" stroke="#0369a1" stroke-width="2"/>
  <rect x="260" y="140" width="60" height="280" rx="12" fill="#0284c7" stroke="#0369a1" stroke-width="2"/>
  
  <!-- Dual Pressure Gauges -->
  <circle cx="210" cy="120" r="16" fill="#ffffff" stroke="#475569" stroke-width="2"/>
  <circle cx="290" cy="120" r="16" fill="#ffffff" stroke="#475569" stroke-width="2"/>
  
  <!-- Stainless Steel RO Vessels -->
  <rect x="350" y="150" width="70" height="260" rx="12" fill="#cbd5e1" stroke="#94a3b8" stroke-width="2"/>
  
  <text x="300" y="465" fill="#0f172a" font-family="sans-serif" font-size="16" font-weight="bold" letter-spacing="2" text-anchor="middle">50 LPH DUAL MEMBRANE</text>
</svg>
